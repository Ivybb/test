nting" id="receipt"><h2>情緒雜貨店</h2><div class="center sub">EMOTIONAL GROCERY<br>收下今天，也收下自己。</div><hr><div class="rline"><span>${date}</span><span>MOOD-${date.replaceAll('-','')}</span></div><hr>${events.map((e,i)=>`<div class="rline"><span>${hidden?'今日故事 '+(i+1):esc(e.title)}</span><span>+${e.income} / −${e.cost}</span></div>`).join('')}<hr><div class="rline"><span>情緒收入</span><span>+${t.income}</span></div><div class="rline"><span>情緒成本</span><span>−${t.cost}</span></div><div class="rline" style="font-size:20px"><strong>今日情緒淨值</strong><strong>${sign(t.income-t.cost)}</strong></div><hr><div class="rline"><span>記錄的恢復時間</span><span>${t.recovery} 分鐘</span></div><p class="sub">時間為事件填寫值加總，可能包含重疊時段。</p><hr><div class="sub">♡ 店員留言 · 本地整理</div><p class="rmessage">${message(events)}</p><div class="barcode"></div><div class="center sub">THANK YOU FOR TODAY ♡<br>明天也歡迎光臨</div></div>`}function receiptPage(){const a=state.events.filter(e=>e.date===receiptDate);return head('YOUR DAILY RECEIPT','叮！今天的心情，收好了。','這張收據沒有好壞，只有你今天真實經歷的故事。')+`<div class="twocol"><div>${receipt(a,receiptDate,privateShare)}</div><div class="panel" style="align-self:start"><h2 class="sectiontitle">收藏這一天</h2><p class="lead">收據已存入此瀏覽器的情緒帳本。<br>也可以下載圖片，替今天留一個紀念。</p><label><input type="checkbox" id="sharemode" ${privateShare?'checked':''}> 分享模式：隱藏事件名稱</label><div class="actions"><button class="primary" id="download">↓ 下載收據 PNG</button><button class="secondary" data-go="ledger">翻開我的帳本</button></div><p class="warn">分享模式仍會保留日期、分數與恢復時間，下載前請確認內容。店員留言由本地規則產生，尚未串接 AI。</p></div></div>`}function ledger(){const [y,m]=month.split('-').map(Number),first=new Date(y,m-1,1).getDay(),days=new Date(y,m,0).getDate(),a=state.events.filter(e=>e.date.startsWith(month));return head('YOUR EMOTIONAL JOURNAL','一張張收據，都是生活的模樣。','沒有記錄的日子留白，每一種天氣都值得被溫柔看待。')+`<div class="twocol"><div class="panel"><div class="calendarhead"><button id="prev" aria-label="上一個月">←</button><h2 class="sectiontitle">${y} 年 ${m} 月</h2><button id="next" aria-label="下一個月