>{add(privateShare?'今日故事 '+(i+1):e.title);add('收入 +'+e.income+'   /   成本 −'+e.cost,24,'#7f8972')});add('────────────────────────');add('情緒收入   +'+t.income);add('情緒成本   −'+t.cost);add('今日情緒淨值   '+sign(t.income-t.cost),34);add('記錄的恢復時間   '+t.recovery+' 分鐘');add('────────────────────────');add('♡ 店員留言 · 本地整理',24);add(message(a));add('時間可能重疊；分數不是心理健康診斷。',20,'#7f8972');add('THANK YOU FOR TODAY ♡',24,'#424b3d',true);const ctx=canvas.getContext('2d'),wrapped=[];for(const l of lines){ctx.font=`${l.size}px sans-serif`;let row='';for(const c of l.text){if(ctx.measureText(row+c).width>650){wrapped.push({...l,text:row});row=c}else row+=c}wrapped.push({...l,text:row})}canvas.height=100+wrapped.reduce((n,l)=>n+l.size+24,0);ctx.fillStyle='#fffdf3';ctx.fillRect(0,0,800,canvas.height);let y=65;for(const l of wrapped){ctx.font=`${l.size}px sans-serif`;ctx.fillStyle=l.color;ctx.textAlign=l.center?'center':'left';ctx.fillText(l.text,l.center?400:75,y);y+=l.size+24}canvas.toBlob(blob=>{if(blob){file(blob,'情緒收據-'+receiptDate+(privateShare?'-分享版':'')+'.png');toast('收據圖片已下載')}})}render();
