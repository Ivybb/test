const $=s=>document.querySelector(s), cats=['人際關係','工作與學習','日常生活','自我成長','意外事件','自訂商品'], icons=['♡','▤','☕','✿','☁','＋'], desc=['陪伴，是溫柔的補給','每一份努力都算數','收藏平凡的小確幸','為自己慢慢生長','接住那些措手不及','你的故事，由你命名'];
