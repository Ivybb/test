th?(t.cost/a.length).toFixed(1):'—'}</p></div><div class="sectionhead"><h2>情緒收支趨勢</h2><span class="legend">● 綠色：收入　● 陶紅：成本</span></div><div class="panel">${ds.length?`<svg class="chart" viewBox="0 0 500 195" role="img" aria-label="每日收入成本折線圖">${[0,1,2].map(i=>`<line x1="30" y1="${165-i*70}" x2="470" y2="${165-i*70}" stroke="#dce0d0"/><text x="0" y="${169-i*70}" font-size="10" fill="#969b87">${Math.round(mx*i/2)}</text>`).join('')}<polyline points="${points('income')}" fill="none" stroke="#607a52" stroke-width="3"/><polyline points="${points('cost')}" fill="none" stroke="#b77563" stroke-width="3"/>${ds.map((d,i)=>{const x=30+(ds.length===1?220:i/(ds.length-1)*440),s=sum(a.filter(e=>e.date===d));return `<circle cx="${x}" cy="${165-s.income/mx*140}" r="4" fill="#607a52"/><circle cx="${x}" cy="${165-s.cost/mx*140}" r="4" fill="#b77563"/>${ds.length<12||i===0||i===ds.length-1?`<text x="${x}" y="190" text-anchor="middle" font-size="9" fill="#969b87">${d.slice(5)}</text>`:''}`}).join('')}</svg><details><summary>查看每日數值</summary>${ds.map(d=>{const s=sum(a.filter(e=>e.date===d));return `<div class="rank"><span>${d}</span><span>+${s.income} / −${s.cost}</span></div>`}).join('')}</details>`:'<div class="empty">記下一件事，讓趨勢從這裡開始。</div>'}<p class="sub">折線連接有紀錄的日期，未記錄日期沒有估算分數。</p></div><div class="twocol" style="margin-top:25px">${['income','cost'].map((key,i)=>`<div class="panel"><h2 class="sectiontitle">${i?'☁ 情緒成本來源':'♡ 情緒收入來源'}</h2>${ranks(key).map((r,j)=>`<div class="rank"><span>${j+1}. ${r.c}</span><span class="${key}">${i?'−':'+'}${r.n}</span></div>`).join('')||'<p class="empty">尚無資料</p>'}</div>`).join('')}</div><div class="sectionhead"><h2>隱形情緒帳單</h2></div><div class="panel"><p class="sub">依你填寫的相同標籤彙整；恢復時間可能重疊，不代表浪費時間。</p>${tags.map(q=>`<div class="rank"><span>${esc(q.tag)} · ${q.count} 次</span><span>成本 −${q.cost} · ${q.recovery} 分鐘</span></div>`).join('')||'<p class="empty">在詳細模式加上標籤，開始觀察重複出現的事件。</p>'}<p class="warn">淨值不是越高越好。有意義的事情，也可能需要付出心力。</p></div>`}function supply(){return head('A LITTLE REFILL FOR YOU','留一點溫柔，補給自己。','不必再多完成一個任務。挑一件現在想做的小事就好。')+`<div class="supplygrid">${[['☕','一杯休息券','暫時放下待辦，跟著圓圈慢慢呼吸。','休息一分鐘','breathe'],['✉','小確幸收藏','翻出曾經讓你感到開心的一個片刻。','打開快樂存貨','happy'],['☾','晚安優惠券','允許自己把不急的事留給明天。','領取今晚的溫柔','night']].map(([i,t,d,b,k])=>`<div class="panel"><div style="font-size:30px">${i}</div><h3>${t}</h3><p>${d}</p><button class="secondary" data-supply="${k}">${b} ↗</button></div>`).join('')}</div><div class="note" style="margin-top:30px"><h2 class="sectiontitle">來自你的快樂貨架</h2><p>${esc((state.events.filter(e=>e.income>=4).sort((a,b)=>b.income-a.income)[0]||{}).title||'還沒有存貨也沒關係。今天有沒有一件微小、但讓你感到舒服的事？')}</p><div class="sub">依你的紀錄整理 · 不是 AI 分析</div></div>`}function render(){count();app.innerHTML=({home,cart,receipt:receiptPage,ledger,reports,supply}[page]||home)();document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));bind()}function go(p){page=p;render();window.scrollTo({top:0,behavior:'smooth'})}function modal(html){$('#modalbody').innerHTML=html;$('#modal').showModal()}let editId=null;function bind(){if(page==='cart'){$('#income').oninput=e=>$('#iv').textContent=e.target.value;$('#cost').oninput=e=>$('#cv').textContent=e.target.value;$('#entry').onsubmit=e=>{e.preventDefault();const title=$('#title').value.trim();if(!title)return toast('先寫下一件今天的故事吧。');const entry={id:editId||crypto.randomUUID(),title,category:$('#category').value,income:+$('#income').value,cost:+$('#cost').value,recovery:+$('#recovery').value||0,tag:$('#tag').value.trim(),impact:[...document.querySelectorAll('[name=impact]:checked')].map(x=>x.value)};if(editId)state.draft=state.draft.map(x=>x.id===editId?entry:x);else state.draft.push(entry);editId=null;save();render();toast('已收進情緒購物車 ♡')};$('#checkout').onclick=()=>{if(!state.draft.length)return;const date=$('#entrydate').value;if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||date>today())return toast('請選擇今天或過去的日期。');const old=JSON.stringify(state);state.events.push(...state